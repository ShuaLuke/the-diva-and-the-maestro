---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  { href: '/book', label: 'The Book' },
  { href: '/the-box', label: 'The Box' },
  { href: '/abbie', label: 'The Diva' },
  { href: '/will-marion', label: 'The Maestro' },
  { href: '/timeline', label: 'Timeline' },
  { href: '/archive', label: 'Archive' },
  { href: '/people', label: 'People' },
  { href: '/authors', label: 'Authors' },
  { href: '/plan', label: 'Plan' },
];
const path = (Astro.url.pathname.slice(base.length) || '/').replace(/\/$/, '') || '/';
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={`${base}/`}><span class="diva">The Diva</span> <span class="amp">and</span> <span class="maestro">the Maestro</span></a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={`${base}${item.href}`} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--line); background: var(--paper); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding-top: 18px; padding-bottom: 18px; }
  .brand { font-family: var(--display); font-size: 22px; color: var(--ink); text-decoration: none; white-space: nowrap; }
  .brand .amp { color: var(--muted); font-size: .8em; }
  nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  nav a { font-size: 13px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); text-decoration: none; padding: 6px 0; border-bottom: 2px solid transparent; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--gilt); }
  @media (max-width: 720px) { .bar { justify-content: center; text-align: center; } nav ul { justify-content: center; gap: 4px 16px; } }
</style>
