---
import Layout from '../../layouts/Layout.astro';
import ArchiveTile from '../../components/ArchiveTile.astro';
import { sorted, kinds, type Kind } from '../../data/archive';
const groups = (Object.keys(kinds) as Kind[]).map((k) => ({ kind: k, label: kinds[k], items: sorted.filter((i) => i.kind === k) })).filter((g) => g.items.length);
---
<Layout title="Archive" description="Photographs, sheet music, programs, places, and recordings from the world of Abbie Mitchell and Will Marion Cook.">
  <div class="wrap page-title">
    <p class="eyebrow gilt">The Archive</p>
    <h1>Photographs, scores, and places</h1>
    <p class="lede">Every item carries its date, its source, and its rights. The family's own collection will join these as it is scanned.</p>
  </div>

  <div class="wrap">
    <nav class="jump" aria-label="Sections">
      {groups.map((g) => <a href={`#${g.kind}`}>{g.label} <span class="tabular">{g.items.length}</span></a>)}
    </nav>

    {groups.map((g) => (
      <section class="section" id={g.kind}>
        <div class="section-head"><h2>{g.label}</h2></div>
        <div class="grid-4">
          {g.items.map((item) => <ArchiveTile item={item} />)}
        </div>
      </section>
    ))}
  </div>
</Layout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 8px 28px; padding: 24px 0 0; }
  .jump a { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); text-decoration: none; font-weight: 500; }
  .jump a span { color: var(--gilt); margin-left: 4px; }
  .jump a:hover { color: var(--oxblood); }
</style>
