---
import Layout from '../layouts/Layout.astro';
import { people } from '../data/people';
const historic = people.filter((p) => p.group === 'historic');
const family = people.filter((p) => p.group === 'family');
---
<Layout title="Cast of Characters" description="The historic figures and the Cook family who appear in The Diva and the Maestro.">
  <div class="wrap page-title">
    <p class="eyebrow gilt">Cast of Characters</p>
    <h1>Who's who</h1>
    <p class="lede">The people Abbie and Will Marion worked with, learned from, fought with, and raised.</p>
  </div>

  <div class="wrap">
    <div class="note" style="margin-top:32px">
      <p>These entries are placeholders drawn from the prologue and public sources. The book's own biographic summaries will replace them.</p>
    </div>

    <section class="section">
      <div class="section-head"><h2>Historic characters</h2></div>
      <div class="list">
        {historic.map((p) => (
          <article>
            <h3>{p.archive ? <a href={`/archive/${p.archive}`}>{p.name}</a> : p.name}</h3>
            <p class="role"><span class="tabular">{p.dates}</span>{p.dates && ' · '}{p.role}</p>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-head"><h2>The Cook family</h2></div>
      <div class="list">
        {family.map((p) => (
          <article>
            <h3>{p.name}</h3>
            <p class="role"><span class="tabular">{p.dates}</span>{p.dates && ' · '}{p.role}</p>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 48px; }
  article { border-top: 1px solid var(--line); padding-top: 16px; }
  h3 { font-size: 23px; margin-bottom: 4px; }
  h3 a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--gilt); }
  h3 a:hover { color: var(--oxblood); }
  .role { font-size: 13px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 10px; }
  article p:last-child { color: var(--ink-2); font-size: 15.5px; margin: 0; }
  @media (max-width: 700px) { .list { grid-template-columns: 1fr; } }
</style>
